{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Line chart showing trend over time.",
  "data": {"url": "data/data2.json"},
  "mark": {"type": "line", "point": true, "color": "#2c7fb8"},
  "encoding": {
    "x": {"field": "year", "type": "temporal", "timeUnit": "year", "axis": {"title": "Year"}},
    "y": {"field": "metric", "type": "quantitative", "axis": {"title": "Index Value"}}
  }
}